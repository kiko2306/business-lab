# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

MINIFLUX_PORT=10520

# MINIFLUX_DB_PASSWORD (internal app <-> Postgres) and MINIFLUX_ADMIN_PASSWORD
# are left blank — the dashboard generates both (hex) on first start. The admin
# password is shown in the Configuration panel so you can log in with it; the
# DB password is hidden.
MINIFLUX_DB_NAME=miniflux
MINIFLUX_DB_USER=miniflux
MINIFLUX_DB_PASSWORD=
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=

# Public URL Miniflux builds cookie paths, share links and the PWA manifest
# against. The dashboard rewrites this to the generated https:// hostname once
# exposure is enabled. Restart to apply.
MINIFLUX_BASE_URL=http://localhost:10520

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
