# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

OUTLINE_PORT=10620
# Must match the URL Outline is reached at. Injected from the public
# hostname when exposure is enabled in the dashboard (restart to apply).
OUTLINE_URL=http://localhost:10620

# Left blank; the dashboard generates these on first start. The DB password is
# internal (app <-> Postgres). SECRET_KEY signs sessions and encrypts stored
# tokens and is shown in the Configuration panel — back it up; losing it logs
# everyone out and breaks integrations. UTILS_SECRET authenticates Outline's
# own scheduled-task endpoints.
OUTLINE_DB_NAME=outline
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD=
OUTLINE_SECRET_KEY=
OUTLINE_UTILS_SECRET=

# Authelia OIDC client secret. Generated by the dashboard on first start; the
# matching hash is registered in Authelia automatically. Every other OIDC_*
# value is injected from the exposure settings — Outline has no local login,
# so it only becomes usable once the app is exposed.
OUTLINE_OIDC_CLIENT_SECRET=
