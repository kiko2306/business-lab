# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Set by hand from https://login.tailscale.com/admin/settings/keys, OR left
# as change-me and generated/kept fresh automatically once the OAuth client
# below is set — see TAILSCALE_OAUTH_CLIENT_ID. If a token is set, this value
# (and TAILSCALE_AUTH_KEY_ID) are dashboard-managed from then on; edits here
# are overwritten on the next tailscale start.
TAILSCALE_AUTH_KEY=change-me
# Internal bookkeeping for the automation above — which key TAILSCALE_AUTH_KEY
# actually is, so its validity/expiry can be checked before re-minting a new
# one. Never hand-edit; blank when the key was set by hand.
TAILSCALE_AUTH_KEY_ID=

# A Tailscale OAuth client (Settings → OAuth clients in Tailscale's admin
# console), scoped to auth_keys + policy_file, tagged tag:businesslab (must
# match the tag the compose file's TS_EXTRA_ARGS advertises — Tailscale
# requires an OAuth-issued auth key's tags to match/be owned by the client's
# own tags). Genuinely third-party — only Tailscale's own UI can mint it —
# entered once through this app's config in the Business Lab dashboard.
# With it set, the dashboard mints/refreshes TAILSCALE_AUTH_KEY itself
# (90-day max per Tailscale's own API, self-renewed automatically before it
# expires — no human step) and enables Funnel on the tailnet's ACL policy
# (one nodeAttrs entry merged in, not a wholesale overwrite) instead of the
# manual one-click step in first-run.md. Optional: leave as change-me to do
# both by hand instead.
TAILSCALE_OAUTH_CLIENT_ID=change-me
TAILSCALE_OAUTH_CLIENT_SECRET=change-me

# Optional. The tailnet node name for this box — the compose file defaults it
# to `businesslab-signal`, which is what NetBird's signal server is published
# at. Only set this if two Business Lab deployments share one tailnet and would
# otherwise collide (Tailscale would append `-2` to the second, breaking the
# stable signal hostname). Blank = use the compose default.
TS_HOSTNAME=
