# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

TAILSCALE_AUTH_KEY=change-me

# Optional. The tailnet node name for this box — the compose file defaults it
# to `businesslab-signal`, which is what NetBird's signal server is published
# at. Only set this if two Business Lab deployments share one tailnet and would
# otherwise collide (Tailscale would append `-2` to the second, breaking the
# stable signal hostname). Blank = use the compose default.
TS_HOSTNAME=
