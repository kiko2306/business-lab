# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

PAPERLESS_PORT=10310
# DB password, Django secret key and the initial superuser password are left
# blank — the dashboard generates all three on first start. The DB password is
# internal; the secret key and admin password are shown in the Configuration
# panel (back up the secret key, sign in with the admin password).
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=

PAPERLESS_SECRET_KEY=

PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

PAPERLESS_TIME_ZONE=Europe/Lisbon

# PAPERLESS_URL, PAPERLESS_ALLOWED_HOSTS and PAPERLESS_CSRF_TRUSTED_ORIGINS are
# not set here: when exposure is enabled for this service in the dashboard, the
# backend injects them automatically at start time from the configured public
# hostname. They fall back to http://localhost:10310 / localhost,127.0.0.1
# otherwise. Restart the service after toggling exposure so the new values apply.
