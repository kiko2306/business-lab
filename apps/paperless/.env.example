# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

PAPERLESS_PORT=8000

# Postgres credentials — PAPERLESS_DB_PASSWORD has no default.
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=change-me

# Django secret key; use a long random value.
PAPERLESS_SECRET_KEY=change-me

# Initial superuser created on first start.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me

PAPERLESS_TIME_ZONE=UTC

# PAPERLESS_URL and PAPERLESS_ALLOWED_HOSTS are not set here: when exposure is
# enabled for this service in the dashboard, the backend injects them
# automatically at start time from the configured public hostname. They fall
# back to http://localhost:8000 / localhost,127.0.0.1 otherwise.
