# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

N8N_PORT=10240
# N8N_DB_PASSWORD and N8N_ENCRYPTION_KEY are left blank — the dashboard
# generates both on first start. The DB password is internal; the encryption
# key is shown in the Configuration panel and MUST be backed up — without it,
# credentials stored in n8n can't be decrypted after a data-volume loss.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

N8N_ENCRYPTION_KEY=

# Public URL bits. When exposure is enabled in the dashboard these are set
# automatically at start time (N8N_HOST/N8N_PROTOCOL and the webhook/editor
# URLs), so the editor stops complaining about a non-HTTPS secure cookie and
# webhook URLs come out right. Restart the service after toggling exposure.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:10240/
N8N_EDITOR_BASE_URL=http://localhost:10240/
