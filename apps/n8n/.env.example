# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

N8N_PORT=5678

# Postgres credentials — N8N_DB_PASSWORD has no default.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me

# Encryption key for credentials stored in n8n; use a long random value.
N8N_ENCRYPTION_KEY=change-me

N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
