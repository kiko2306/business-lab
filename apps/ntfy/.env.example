# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NTFY_PORT=10290
# Public URL ntfy builds links against. The dashboard rewrites this to the
# generated https:// hostname automatically once exposure is enabled. Restart
# to apply.
NTFY_BASE_URL=http://localhost:10290

# Set to true only when ntfy is reached through the reverse proxy — the
# dashboard sets this automatically once exposure is enabled. Restart to apply.
NTFY_BEHIND_PROXY=false

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# Read-only ntfy access token for subscribing to the alert topic from the
# ntfy phone/desktop app. Generated automatically on first start (ntfy runs
# with NTFY_AUTH_DEFAULT_ACCESS=write-only, so publishing stays anonymous and
# reading needs this) — read the value in ntfy's config panel and paste it
# into the app. Leave blank; regenerate by clearing it and restarting ntfy.
NTFY_SUBSCRIBE_TOKEN=
