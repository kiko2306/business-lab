# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

UPTIME_KUMA_PORT=10370
# Password for the admin account the dashboard creates on first start, which
# is what clears Uptime Kuma's first-run setup wizard. The username is the
# Authelia admin's username. With "Disable Auth" on (this app's default —
# Authelia is the only gate), this is never used to log in; it matters only
# if someone turns Uptime Kuma's own auth back on. Auto-generated if blank.
UPTIME_KUMA_ADMIN_PASSWORD=
