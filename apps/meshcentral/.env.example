# Copy to .env in this directory and set values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

MESHCENTRAL_PORT=10510

# These are managed by the dashboard's exposure system and injected at start
# time — leave them blank. When MeshCentral is exposed they become
# mesh.<base-domain> / the Docker bridge gateway IP / "true"; with exposure
# off they stay empty and MeshCentral serves its own HTTPS for LAN use.
MESHCENTRAL_HOSTNAME=
MESHCENTRAL_TLS_OFFLOAD=
MESHCENTRAL_TRUSTED_PROXY=

# Password for the site-admin account the dashboard creates on first start
# (the Authelia admin's username + email). Auto-generated on first start if
# left blank; set your own here first if you want to choose it.
MESHCENTRAL_ADMIN_PASSWORD=
