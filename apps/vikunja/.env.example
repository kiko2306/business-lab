# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

VIKUNJA_PORT=10390
# Public URL Vikunja builds links against. The dashboard rewrites this to the
# generated https:// hostname automatically once exposure is enabled.
VIKUNJA_PUBLIC_URL=http://localhost:10390

# Signs auth tokens — left blank, the dashboard generates it on first start
# and shows it in the Configuration panel (back it up; rotating it logs
# everyone out).
VIKUNJA_JWT_SECRET=

# SMTP (VIKUNJA_MAILER_*) is inherited from the dashboard's global mail
# settings (Settings → Email) — nothing to set here. The backend injects it
# and enables the mailer at start when those are configured.

# OIDC login via Authelia (plan.md §270). The client secret is generated on
# first config save; VIKUNJA_AUTH_OPENID_* are injected by the dashboard at
# start when Vikunja is exposed. Nothing to set here.
VIKUNJA_OIDC_CLIENT_SECRET=
# After one successful Authelia sign-in, an admin can set this to false to
# drop Vikunja's own login form (Authelia becomes the only gate).
VIKUNJA_AUTH_LOCAL_ENABLED=true
