# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

VIKUNJA_PORT=3456
VIKUNJA_PUBLIC_URL=http://localhost:3456

# Signs auth tokens — no default, generate a long random value, e.g.
# `openssl rand -hex 32`.
VIKUNJA_JWT_SECRET=change-me
