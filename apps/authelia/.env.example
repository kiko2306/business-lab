# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

AUTHELIA_PORT=10100
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# Session/storage/JWT/OIDC secrets — no defaults, Authelia will not start
# without them. Generate long random values, e.g. `openssl rand -hex 64`.
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me
AUTHELIA_JWT_SECRET=change-me
AUTHELIA_OIDC_HMAC_SECRET=change-me

# The public domain every hostname in config/configuration.yml is derived
# from ({{ env "BASE_DOMAIN" }} there, via the `template` config filter that
# docker-compose.yml enables). start.sh writes this for you from the domain it
# prompts for; set it by hand only if you're not using start.sh. There is no
# default on purpose — an empty value yields a broken cookie domain and OIDC
# issuer rather than a clear error.
BASE_DOMAIN=
# Before first start, also:
#   - edit config/users_database.yml — replace the example user's password hash
#   - generate the OIDC signing key into data/oidc-secrets.yml — start.sh
#     does this automatically; the manual recipe is below (gitignored,
#     not shipped in the repo — see identity_providers.oidc in
#     configuration.yml for why it's a separate file). From this directory:
#       mkdir -p data
#       openssl genrsa 4096 | sed 's/^/          /' > /tmp/oidc-key.txt
#       { echo 'identity_providers:'; echo '  oidc:'; echo '    jwks:'; \
#         echo "      - key_id: 'main'"; echo "        algorithm: 'RS256'"; \
#         echo "        use: 'sig'"; echo '        key: |'; cat /tmp/oidc-key.txt; \
#       } > data/oidc-secrets.yml
#       rm /tmp/oidc-key.txt
