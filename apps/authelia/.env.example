# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

AUTHELIA_PORT=9091
TZ=UTC

# Session/storage/JWT secrets — no defaults, Authelia will not start without
# them. Generate long random values, e.g. `openssl rand -hex 64`.
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me
AUTHELIA_JWT_SECRET=change-me

# Before first start, also edit:
#   config/configuration.yml  — session cookie domain/URLs for your setup
#   config/users_database.yml — replace the example user's password hash
