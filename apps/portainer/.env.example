# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Portainer's web UI. start.sh allocates these (and creates this file's .env
# counterpart if it is missing), so normally you never set them by hand — see
# docs/ports.md.
PORTAINER_HTTP_PORT=10330
PORTAINER_HTTPS_PORT=10331

# Portainer has no credential to configure here: the first visit creates the
# admin account, guarded by a setup token the dashboard manages. Claim it
# promptly — Portainer locks itself if left unclaimed too long.
