# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

DOCUSEAL_PORT=10150

# HOST / FORCE_SSL are filled automatically by the dashboard's exposure system
# from the published hostname — leave them unset here.
DOCUSEAL_HOST=
DOCUSEAL_FORCE_SSL=

# Admin password for the account the dashboard creates via DocuSeal's first-run
# /setup wizard (DocuSeal community has no SSO). Auto-generated on first start
# if left blank; set your own here first if you want to choose it.
DOCUSEAL_ADMIN_PASSWORD=
