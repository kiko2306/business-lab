# Copy this template alongside it, without the .example suffix, and set values
# before starting the app. Docker Compose loads it automatically from the app's
# project directory.

HOMEBOX_PORT=10440

# Leave registration open only until the first account exists, then set this to
# false and restart from the dashboard. Whoever opens the port first owns the
# instance while it is true.
HOMEBOX_ALLOW_REGISTRATION=true

# Maximum attachment size in MB (receipts, manuals, photos).
HOMEBOX_MAX_UPLOAD_MB=10

# Peppers stored API keys. At least 32 bytes or the app refuses to start; the
# dashboard generates 64 hex characters. Rotating it invalidates every API key
# already issued.
HOMEBOX_API_KEY_PEPPER=

# OIDC login via Authelia (plan.md §270). The client secret is generated on
# first config save; HBOX_OIDC_* / HBOX_OPTIONS_TRUST_PROXY are injected by the
# dashboard at start when Homebox is exposed. Nothing to set here.
HOMEBOX_OIDC_CLIENT_SECRET=
# After one successful Authelia sign-in, an admin can set this to false to
# drop Homebox's own login form (Authelia becomes the only gate).
HBOX_OPTIONS_ALLOW_LOCAL_LOGIN=true
