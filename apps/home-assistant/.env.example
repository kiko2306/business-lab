# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# There is no HA_PORT: Home Assistant runs with host networking so that its
# zeroconf/SSDP/DHCP discovery can see the LAN, and host networking cannot
# remap ports. It serves on the host's 8123 — the port is HA's own
# http.server_port setting (Settings -> System -> Network), not a compose one.

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# Owner password for the account the dashboard creates via HA's onboarding
# (HA has no SSO — it's exposed directly with its own login). Auto-generated
# on first start if blank; set your own here first to choose it. Read it back
# from this file. Username is the Authelia admin's.
HOMEASSISTANT_ADMIN_PASSWORD=
