# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

JELLYFIN_PORT=10210
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# Absolute host path to your media library, e.g. /home/mat/media. Leave unset
# to just use a folder inside this app's own data dir.
JELLYFIN_MEDIA_DIR=./data/media

# Password for the admin account the dashboard creates by running Jellyfin's
# first-run startup wizard. The username is the Authelia admin's username
# (Jellyfin logins have no email field). Auto-generated on first start if
# left blank; set your own here first if you want to choose it.
JELLYFIN_ADMIN_PASSWORD=
