# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

PRICE_COMPARE_PORT=8015

# Defaults to Europe/Lisbon (not the dashboard-wide default) since every
# store this app scrapes is Portuguese and its daily update runs at 08:00
# in this timezone. Set it here only to override that.
#TZ=Europe/Lisbon

# Google Sign-In — required for login to work at all; the app boots fine
# without these set, but /auth/google returns 503 until they are.
#
# To get these, in https://console.cloud.google.com/apis/credentials :
#   1. Create a project (or pick an existing one).
#   2. "Configure consent screen" — External, fill in the required fields.
#      Add your own Google account under "Test users" if it stays in
#      Testing mode (fine for personal use, no Google review needed).
#   3. "Create credentials" -> "OAuth client ID" -> Application type: Web
#      application.
#   4. Under "Authorized redirect URIs", add exactly the GOOGLE_REDIRECT_URI
#      value below (must match byte-for-byte, including https:// and no
#      trailing slash).
#   5. Copy the generated Client ID and Client Secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://price-compare.tx-home-utils.com/auth/google/callback
