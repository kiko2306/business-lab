# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

DUPLICATI_PORT=8200
PUID=1000
PGID=1000
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# Both left blank — the dashboard generates them on first start and shows both
# in the Configuration panel. Back up DUPLICATI_SETTINGS_ENCRYPTION_KEY: you
# need it to restore Duplicati's own job config after a rebuild.
# DUPLICATI_WEB_PASSWORD is the web-UI login.
DUPLICATI_SETTINGS_ENCRYPTION_KEY=
DUPLICATI_WEB_PASSWORD=

# Host header allow-list. Defaults to "*" (any) so the web UI works behind the
# reverse proxy out of the box; narrow it to specific hostnames if you want,
# but then add the public hostname yourself when enabling exposure.
# DUPLICATI__WEBSERVICE_ALLOWEDHOSTNAMES=*
