# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

DUPLICATI_PORT=8200
PUID=1000
PGID=1000
TZ=Europe/Lisbon

# Encrypts stored backup job settings at rest — no default, minimum 8
# alphanumeric characters. Keep this safe; you need it to restore config.
DUPLICATI_SETTINGS_ENCRYPTION_KEY=change-me

# Password for the Duplicati web UI (defaults to "changeme" upstream if left
# unset — always set this explicitly).
DUPLICATI_WEB_PASSWORD=change-me
