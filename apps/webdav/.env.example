# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

WEBDAV_PORT=10590

# Basic-auth credentials for the one account this server has — read/write
# access to the whole share. Meant for a native client (a backup tool, a
# sync app) that authenticates itself, not a person browsing in — this app
# is exempt from Authelia's forward-auth for exactly that reason
# (skipAutheliaProtection in services.ts): a native WebDAV client can't
# follow Authelia's redirect-to-login-portal.
#
# Both are rendered into the managed data/config.yml on every start
# (backend/src/services/webdavConfig.ts) — this .env is not read by the
# container directly.
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=

# Optional: store files on a NAS's SMB share instead of this host's local
# disk. Leave WEBDAV_NAS_SERVER blank to keep the local default. Rendered
# into the storage volume's mount options by
# backend/src/services/webdavMount.ts — restart WebDAV after changing any of
# these (a change swaps the volume, so existing files stay on whichever
# location they were written to; nothing migrates automatically).
WEBDAV_NAS_SERVER=
WEBDAV_NAS_SHARE=
WEBDAV_NAS_USERNAME=
WEBDAV_NAS_PASSWORD=
