# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

IMMICH_PORT=10200
# IMMICH_DB_PASSWORD is left blank — the dashboard generates it (an internal
# app <-> Postgres credential) on first start, so Immich comes up with no
# configuration step.
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=
# Left blank — the dashboard generates it and creates Immich's first (admin)
# account with it on an exposed start (Immich won't make the first account via
# OAuth). Not read by the container.
IMMICH_ADMIN_PASSWORD=

# OIDC login via Authelia (plan.md §270/§275). The client secret is generated
# on first config save; the dashboard writes data/config/immich.json and
# injects IMMICH_CONFIG_FILE while Immich is exposed. Nothing to set here.
IMMICH_OIDC_CLIENT_SECRET=
# After one successful Authelia sign-in, an admin can set this to false to
# drop Immich's own email/password form (Authelia becomes the only gate).
IMMICH_PASSWORD_LOGIN_ENABLED=true
