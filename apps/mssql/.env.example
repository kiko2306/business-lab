# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Host port for the SQL Server wire protocol (container listens on 1433).
# LAN-only — not exposed through the tunnel (§121.4).
MSSQL_PORT=10540

# The `sa` password. Backend-generated on first Configuration save (never
# entered by hand), to a value that satisfies SQL Server's policy: 8-128
# chars, 3 of 4 of upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=

# Written as ACCEPT_EULA=Y by the dashboard once the operator accepts the
# Microsoft SQL Server 2022 licence in the UI (§121.5). Leave blank — the
# container will not start until it is set, which is intentional.
ACCEPT_EULA=

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
