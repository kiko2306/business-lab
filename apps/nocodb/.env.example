# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NOCODB_PORT=8011

# NOCODB_DB_PASSWORD and NOCODB_JWT_SECRET are left blank — the dashboard
# generates both (hex) on first start. The DB password is internal (app <->
# Postgres); the JWT secret is shown in the Configuration panel so it can be
# backed up (rotating it drops all sessions).
NOCODB_DB_NAME=nocodb
NOCODB_DB_USER=nocodb
NOCODB_DB_PASSWORD=
NOCODB_JWT_SECRET=

# Public URL NocoDB builds invite/share/email links against. The dashboard
# rewrites this to the generated https:// hostname once exposure is enabled.
# Restart to apply.
NOCODB_PUBLIC_URL=http://localhost:8011

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
