# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NOCODB_PORT=8011

# Postgres credentials — NOCODB_DB_PASSWORD has no default and the database
# will fail to start if it is empty. Keep it alphanumeric: it is substituted
# into NocoDB's pg:// connection string, where reserved URL characters break
# parsing.
NOCODB_DB_NAME=nocodb
NOCODB_DB_USER=nocodb
NOCODB_DB_PASSWORD=change-me

# Signs auth tokens — no default. The dashboard's Configuration panel
# pre-fills this with a generated value; otherwise set one yourself, e.g.
# `openssl rand -hex 32`.
NOCODB_JWT_SECRET=change-me

# Public URL NocoDB builds invite/share/email links against. The dashboard
# rewrites this to the generated https:// hostname once exposure is enabled.
# Restart to apply.
NOCODB_PUBLIC_URL=http://localhost:8011

TZ=Europe/Lisbon
