# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

STIRLING_PDF_PORT=8009

# Stirling-PDF does no Host-header validation, so exposure needs no extra
# config — put it behind Authelia in the dashboard's Exposure settings rather
# than turning on the app's own login below.
STIRLING_PDF_ENABLE_SECURITY=false
STIRLING_PDF_ENABLE_LOGIN=false

STIRLING_PDF_LANGS=en_GB
STIRLING_PDF_LOCALE=en-US

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
