# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

METABASE_PORT=10510

# METABASE_DB_PASSWORD and METABASE_ENCRYPTION_KEY are left blank — the
# dashboard generates both (hex) on first start. The DB password is internal
# (Metabase <-> its Postgres); the encryption key is shown in the
# Configuration panel so it can be backed up — losing it means re-entering
# the password for every database Metabase connects to.
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=
METABASE_ENCRYPTION_KEY=

# Public URL Metabase builds email/share/SSO links against. The dashboard
# rewrites this to the generated https:// hostname once exposure is enabled.
# Restart to apply.
METABASE_SITE_URL=http://localhost:10510

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
