# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

BESZEL_PORT=8090

# Beszel keeps its own user database. These seed the first login on an empty
# database only (they're ignored once a user exists) so the bundled agent can
# self-register without any dashboard clicks. Change the password from the
# Beszel UI (Settings) after the first start.
BESZEL_ADMIN_EMAIL=admin@homelab.local
BESZEL_ADMIN_PASSWORD=changeme-beszel

# Display name for this host in the Beszel dashboard.
BESZEL_SYSTEM_NAME=homelab
