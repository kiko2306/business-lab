# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

SYNCTHING_PORT=10500

# The container writes to ./data as this uid/gid (the image's entrypoint
# chowns /var/syncthing to match). Defaults to 1000 — override only if the
# host user owning apps/syncthing/data is different.
SYNCTHING_PUID=1000
SYNCTHING_PGID=1000

# Sync (22000/tcp+udp) and local discovery (21027/udp) are published on fixed
# ports in docker-compose.yml — other Syncthing devices expect 22000, so they
# are not configurable here. There is no router port-forward for them
# (principle 1); off-LAN peers use the public relay pool.
