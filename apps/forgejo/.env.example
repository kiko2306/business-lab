# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

FORGEJO_PORT=10560
# SSH git access (ssh://git@<host>:10561/owner/repo). LAN/VPN only — the
# tunnel carries HTTP, not SSH.
FORGEJO_SSH_PORT=10561

# ROOT_URL / DOMAIN are injected from the public hostname when exposure is
# enabled in the dashboard (restart to apply). Nothing to set here.
FORGEJO_ROOT_URL=
FORGEJO_DOMAIN=

# Leave false until the first account (which becomes admin) exists, then set
# true from the Configuration panel to close sign-ups.
FORGEJO_DISABLE_REGISTRATION=false
