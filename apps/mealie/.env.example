# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

MEALIE_PORT=10230
# Public URL used to generate links (recipe shares, notifications, etc.)
# Injected from the public hostname when exposure is enabled (restart to apply).
MEALIE_BASE_URL=http://localhost:10230

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# Backend-generated on first Configuration save, never entered by hand. The
# dashboard rotates Mealie's shipped changeme@example.com/MyPassword default
# to this and then logs in with it to wire AI recipe parsing (§238). Not read
# by the container.
MEALIE_ADMIN_PASSWORD=

# OIDC login via Authelia (plan.md §270/§274). The client secret is generated
# on first config save; OIDC_* are injected by the dashboard at start when
# Mealie is exposed. Nothing to set here.
MEALIE_OIDC_CLIENT_SECRET=
# After one successful Authelia sign-in, an admin can set this to false to
# drop Mealie's own login form (Authelia becomes the only gate).
ALLOW_PASSWORD_LOGIN=true
