# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

KOPIA_PORT=10470
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# All three are generated by the dashboard on first start and shown in the
# Configuration panel. Back up KOPIA_PASSWORD: it is the repository encryption
# password, and without it the snapshots cannot be read on a rebuild or a
# restore to another host. The image is configured not to persist it into
# ./data/config, so it must stay set here.
#
# The web-UI / REST-API username is fixed to "kopia" in the compose file.
# KOPIA_SERVER_PASSWORD is that login's password; KOPIA_SERVER_CONTROL_PASSWORD
# gates the control API that `kopia server` management commands use.
KOPIA_PASSWORD=
KOPIA_SERVER_PASSWORD=
KOPIA_SERVER_CONTROL_PASSWORD=

# ---------------------------------------------------------------------------
# Where the Kopia repository lives
#
# Set from the dashboard (Settings -> Backup destination), not by hand.
# BACKUP_REPO_KIND picks which group below entrypoint.sh actually uses.
#
# filesystem (disk/NFS/SMB) — three Docker local-driver options:
#
#   another disk   BACKUP_MOUNT_TYPE=none  OPTIONS=bind              DEVICE=/mnt/backups
#   NFS / NAS      BACKUP_MOUNT_TYPE=nfs   OPTIONS=addr=10.0.0.5,rw  DEVICE=:/volume1/backup
#   SMB / network  BACKUP_MOUNT_TYPE=cifs  OPTIONS=username=..,...   DEVICE=//10.0.0.5/backup
#
# s3 (plan.md §221) — a Kopia-native remote, no kernel mount at all. Covers
# AWS S3 and any S3-compatible endpoint (MinIO, B2, Wasabi, …): leave
# BACKUP_S3_ENDPOINT blank for AWS itself, or set it for anything else.
# BACKUP_S3_EXTRA_ARGS is raw, appended verbatim to `kopia repository connect
# s3` — e.g. `--region=us-east-1` or `--disable-tls` for a plain-HTTP
# endpoint like a LAN MinIO.
#
# ftp / ftps / sftp (plan.md §267, §356) — BACKUP_REPO_KIND=rclone. Kopia has
# no FTP or SFTP backend of its own, so entrypoint.sh drives the rclone
# bundled in the image: it writes an rclone "backup" remote of
# type=$BACKUP_RCLONE_TYPE (ftp or sftp) from the vars below (PASS obscured
# into rclone.conf at start) and runs
# `kopia repository create rclone --remote-path=backup:<REMOTE_PATH>`.
# REMOTE_PATH "/" (or blank) is the remote's root. TLS=true adds explicit FTPS
# (ftp only). SFTP is password-auth only here and does not verify the host key
# unless you pass --sftp-known-hosts-file via BACKUP_RCLONE_EXTRA_ARGS.
#
# gdrive is still open (plan.md §194). The default below keeps the repository
# in this app's own data directory — on the same disk as everything it
# protects, so set a real destination before relying on it.
BACKUP_REPO_KIND=filesystem
BACKUP_MOUNT_TYPE=none
BACKUP_MOUNT_OPTIONS=bind
BACKUP_MOUNT_DEVICE=./data/repository
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_EXTRA_ARGS=
BACKUP_RCLONE_TYPE=
BACKUP_RCLONE_HOST=
BACKUP_RCLONE_PORT=
BACKUP_RCLONE_USER=
BACKUP_RCLONE_PASS=
BACKUP_RCLONE_REMOTE_PATH=
BACKUP_RCLONE_TLS=
BACKUP_RCLONE_EXTRA_ARGS=
