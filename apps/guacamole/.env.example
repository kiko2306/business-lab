# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

GUACAMOLE_PORT=10430

# Credentials for Guacamole's own bundled Postgres. Nothing outside this
# compose project ever uses them, so the dashboard generates the password
# rather than asking — see hiddenGeneratedSecrets in services.ts.
GUACAMOLE_DB_NAME=guacamole
GUACAMOLE_DB_USER=guacamole
GUACAMOLE_DB_PASSWORD=
