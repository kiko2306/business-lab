# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

KITCHEN_SWITCHER_PORT=10220
# No env-driven config — Mealie/Grocy URLs default to this host's LAN ports
# (9925 / 8012) and can be overridden per-browser via the gear icon in the
# page itself (saved to localStorage), e.g. to point at public hostnames
# once both apps are exposed externally.
