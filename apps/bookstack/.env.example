# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

BOOKSTACK_PORT=10120
# Must match the URL BookStack is reached at. Injected from the public
# hostname when exposure is enabled in the dashboard (restart to apply).
BOOKSTACK_URL=http://localhost:10120

# Left blank; the dashboard generates these on first start — the two MariaDB
# passwords (internal app <-> DB) and the Laravel APP_KEY (base64:<32 bytes>),
# which BookStack refuses to boot without.
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=
BOOKSTACK_DB_ROOT_PASSWORD=
BOOKSTACK_APP_KEY=

PUID=1000
PGID=1000
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
