# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

BOOKSTACK_PORT=80
BOOKSTACK_URL=http://localhost:80

# MariaDB credentials — BOOKSTACK_DB_PASSWORD and BOOKSTACK_DB_ROOT_PASSWORD
# have no defaults and the database will fail to start if they are empty.
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=change-me
BOOKSTACK_DB_ROOT_PASSWORD=change-me

PUID=1000
PGID=1000
TZ=Europe/Lisbon
