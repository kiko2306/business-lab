# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.
#
# In practice the dashboard fills this in for you: it generates the blank
# secrets on first start and rewrites POSTIZ_MAIN_URL to the public URL when
# you enable exposure. Nothing here needs to be edited by hand.

POSTIZ_PORT=10530

# Public URL. Left at localhost; the dashboard sets it to https://<hostname>
# at start time once exposure is enabled (and MAIN_URL / FRONTEND_URL /
# NEXT_PUBLIC_BACKEND_URL are all derived from it). Restart after toggling
# exposure.
POSTIZ_MAIN_URL=http://localhost:10530

# Generated on first start by the dashboard.
#  - POSTIZ_JWT_SECRET is shown in the Configuration panel and MUST be backed
#    up: it signs sessions and encrypts the stored social-provider tokens, so
#    losing it after a data-volume loss means re-connecting every account.
#  - the two DB passwords are purely internal (isolated bridge networks,
#    nothing else connects) and stay hidden.
POSTIZ_JWT_SECRET=

POSTIZ_DB_NAME=postiz
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=

POSTIZ_TEMPORAL_DB_PASSWORD=

# Registration is open so you can create the first account (whoever signs up
# first owns the instance). Set to true from the dashboard once you have your
# account — one client, one owner.
POSTIZ_DISABLE_REGISTRATION=false
