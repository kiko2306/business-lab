# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

SPEEDTEST_PORT=80

# Laravel app key — left blank; the dashboard generates a valid
# base64:<32 bytes> value on first start. Without it every request 500s.
SPEEDTEST_APP_KEY=

# APP_URL is injected from the public hostname when exposure is enabled in the
# dashboard (falls back to http://localhost:80). Restart to apply.

PUID=1000
PGID=1000
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
