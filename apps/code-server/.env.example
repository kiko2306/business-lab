# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

CODE_SERVER_PORT=10130

# code-server's own web login (gates both the LAN port and the tunnel
# hostname — see docker-compose.yml). Auto-generated on first start; you
# never need to set this by hand.
CODE_SERVER_PASSWORD=change-me

# Optional sudo password for the terminal inside code-server
CODE_SERVER_SUDO_PASSWORD=change-me

# Host directory mounted into the IDE, at this same absolute path inside the
# container. Defaults to the host home directory so "~/" is reachable. Narrow
# it to a subdirectory (e.g. /home/mat/www) to keep ~/.ssh, ~/.gnupg and the
# apps/*/.env files out of the browser IDE's blast radius.
CODE_SERVER_HOME=/home/mat

PUID=1000
PGID=1000
# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
