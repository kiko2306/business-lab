# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NEXTCLOUD_PORT=10260
# NEXTCLOUD_DB_PASSWORD and NEXTCLOUD_ADMIN_PASSWORD are left blank — the
# dashboard generates both on first start. The DB password is internal; the
# admin password is shown in the Configuration panel so you can sign in as
# NEXTCLOUD_ADMIN_USER.
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Space-separated list of hostnames/IPs Nextcloud will accept requests for.
# Add your LAN IP and/or public domain here or logins will be rejected.
# When exposure is enabled in the dashboard, the public hostname is appended
# here and OVERWRITEHOST/OVERWRITEPROTOCOL/TRUSTED_PROXIES are set for you at
# start time (restart the service to apply).
NEXTCLOUD_TRUSTED_DOMAINS=localhost
