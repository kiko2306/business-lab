# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

VAULTWARDEN_PORT=10380
# Public URL vaultwarden is reached at — required for attachments/WebAuthn to
# work correctly, especially once this sits behind the reverse proxy. Injected
# from the public hostname when exposure is enabled (restart to apply).
VAULTWARDEN_DOMAIN=http://localhost:10380

# Turn off once your account(s) are created to block further signups.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Unlocks the /admin panel — left blank, the dashboard generates it on first
# start and never displays it (see the recovery docs to rotate it).
VAULTWARDEN_ADMIN_TOKEN=
