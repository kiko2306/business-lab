# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

VAULTWARDEN_PORT=8222

# Public URL vaultwarden is reached at — required for attachments/WebAuthn to
# work correctly, especially once this sits behind the reverse proxy.
VAULTWARDEN_DOMAIN=http://localhost:8222

# Turn off once your account(s) are created to block further signups.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Enables the /admin panel — no default, generate a long random value, e.g.
# `openssl rand -base64 48`.
VAULTWARDEN_ADMIN_TOKEN=change-me
