# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Host ports published by the proxy
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=10270
# MySQL credentials — NPM_DB_PASSWORD and NPM_DB_ROOT_PASSWORD have no defaults
# and the database will fail to start if they are empty.
NPM_DB_NAME=npm
NPM_DB_USER=npm
NPM_DB_PASSWORD=change-me
NPM_DB_ROOT_PASSWORD=change-me
