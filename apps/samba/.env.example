# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.
#
# In normal use you do not touch this file: the dashboard generates
# SAMBA_PASSWORD on first start and writes the share definition to
# data/smb.conf. Set your own SAMBA_PASSWORD in the dashboard's config panel
# if you need to know it to map the drive from Windows.

# SMB port. Fixed at 445 — Windows cannot be told to use another. See
# docs/ports.md; the dashboard renders this read-only.
SAMBA_PORT=445

# The single share's name (what shows up as \\host\<name>) and the account
# used to connect to it.
SAMBA_SHARE_NAME=share
SAMBA_USER=labshare

# Generated by the dashboard on first start when left at this placeholder.
SAMBA_PASSWORD=change-me

# Owner uid/gid applied to files in the share.
SAMBA_UID=1000
SAMBA_GID=1000
