# Copy this template alongside it, without the .example suffix, and set values
# before starting the app. Docker Compose loads it automatically from the app's
# project directory.

# clamd's scanning socket, reachable from other apps via the docker gateway.
CLAMAV_PORT=10450

# Signature update checks per day. 2 is upstream's default and plenty; the
# database is roughly 1 GB and each check is a delta.
CLAMAV_FRESHCLAM_CHECKS=2
