# SCHEMA REFERENCE ONLY — you do not need to touch this.
#
# On every CrowdSec start the dashboard backend (services/crowdsecConfig.ts)
# renders the real notifications/http.yaml (gitignored) next to this file from
# the "CrowdSec alerts" setting. This copy documents the shape.
#
# It configures CrowdSec's built-in notification-http plugin. profiles.yaml
# references it as `http_default`. The body is the raw models.Alert list as
# JSON; the n8n relay workflow reshapes it before ntfy.
#
# `url` points at the n8n relay workflow's webhook via
# `host.docker.internal:<N8N_PORT>` (the crowdsec service has
# host.docker.internal:host-gateway as an extra_host). That workflow
# (services/n8nWorkflows.ts, provisioned by n8n-workflows-init) formats the
# alert and forwards it to the shared ntfy topic from Settings → "ntfy
# alerts", so a scanner hit lands as a phone push for anyone subscribed.

type: http
name: http_default
log_level: info

group_wait: 30s      # collect alerts this long before sending one message
group_threshold: 10  # ...or send early once this many have piled up (int)
max_retry: 2
timeout: 10s

format: |
  {{ .|toJson }}

url: "http://host.docker.internal:10240/webhook/crowdsec-alert"
method: POST
headers:
  Content-Type: application/json
