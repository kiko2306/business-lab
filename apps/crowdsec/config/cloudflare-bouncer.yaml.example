# SCHEMA REFERENCE ONLY — you do not need to touch this.
#
# On every CrowdSec start the dashboard backend (services/crowdsecConfig.ts)
# renders the real cloudflare-bouncer.yaml (gitignored) next to this file from
# the stored Cloudflare account/zone/token and CROWDSEC_BOUNCER_KEY. This copy
# just documents the shape and the token scope it needs.
#
# The bouncer pulls ban decisions from the local CrowdSec API and mirrors them
# into a Cloudflare "IP List" that a zone firewall rule blocks — so scanners
# are stopped at Cloudflare's edge, before the tunnel.

crowdsec_lapi_url: http://crowdsec:8080/
# Must equal CROWDSEC_BOUNCER_KEY in this app's .env (that value auto-registers
# the "cloudflare" bouncer in the agent on startup).
crowdsec_lapi_key: <CROWDSEC_BOUNCER_KEY>
crowdsec_update_frequency: 10s
include_scenarios_containing: []
exclude_scenarios_containing: []
only_include_decisions_from: []
key_path: ""
cert_path: ""
ca_cert_path: ""

cloudflare_config:
  accounts:
    # Cloudflare account ID — same as the dashboard's exposure settings.
    - id: <CF_ACCOUNT_ID>
      # A DEDICATED API token, not the tunnel one: it needs
      #   Account > Account Filter Lists : Edit
      #   Zone    > Firewall Services    : Edit
      # scoped to the zone below. Create it at
      # https://dash.cloudflare.com/profile/api-tokens
      token: <CF_API_TOKEN_WITH_FIREWALL_AND_LISTS_EDIT>
      ip_list_prefix: crowdsec
      default_action: block
      total_ip_list_capacity: 10000
      zones:
        # Cloudflare zone ID for your base domain — same as exposure settings.
        - zone_id: <CF_ZONE_ID>
          actions:
            - block
  update_frequency: 30s

daemon: false
log_mode: stdout
log_dir: /var/log/
log_level: info
log_max_size: 40
log_max_age: 30
log_max_backups: 3
compress_logs: true

prometheus:
  enabled: false
  listen_addr: 127.0.0.1
  listen_port: "2112"
