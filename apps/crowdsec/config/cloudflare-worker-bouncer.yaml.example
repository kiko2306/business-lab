# SCHEMA REFERENCE ONLY — you do not need to touch this.
#
# On every CrowdSec start the dashboard backend (services/crowdsecConfig.ts)
# renders the real cloudflare-worker-bouncer.yaml (gitignored) next to this
# file from the stored Cloudflare account/zone/token and CROWDSEC_BOUNCER_KEY.
# This copy documents the shape and the token scopes it needs.
#
# The bouncer pulls ban decisions from the local CrowdSec API and deploys a
# Cloudflare Worker + KV namespace + zone routes that drop those IPs at the
# edge, before the tunnel. (Replaces the old IP-list + Firewall-Rules bouncer,
# which Cloudflare's frozen legacy API broke.)
#
# The Cloudflare API token needs, on top of the tunnel/DNS scopes the
# dashboard already uses:
#   Account > Workers Scripts    : Edit
#   Account > Workers KV Storage : Edit
#   Zone    > Workers Routes     : Edit

crowdsec_config:
  lapi_url: http://crowdsec:8080/
  # Must equal CROWDSEC_BOUNCER_KEY in this app's .env (that value
  # auto-registers the "cloudflare" bouncer in the agent on startup).
  lapi_key: <CROWDSEC_BOUNCER_KEY>
  update_frequency: 10s
  include_scenarios_containing: []
  exclude_scenarios_containing: []
  only_include_decisions_from: []
  key_path: ""
  cert_path: ""
  ca_cert_path: ""

cloudflare_config:
  accounts:
    - id: <CF_ACCOUNT_ID>
      token: <CF_API_TOKEN>
      account_name: ""
      ip_list_prefix: crowdsec
      default_action: ban
      total_ip_list_capacity: 10000
      zones:
        - zone_id: <CF_ZONE_ID>
          actions:
            - ban
          default_action: ban
          routes_to_protect: []   # empty = every route on the zone
          turnstile:
            enabled: false        # only needed for captcha/challenge actions

log_mode: stdout
log_level: info

prometheus:
  enabled: false
  listen_addr: 127.0.0.1
  listen_port: "2112"
