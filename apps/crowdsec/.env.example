# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# CrowdSec has no web UI and publishes no host port — its local API is only
# reached by the bundled bouncer over the compose network.

# Shared secret between the CrowdSec agent and the Cloudflare bouncer. Any long
# random string (e.g. `openssl rand -hex 32`). The dashboard's Configuration
# panel pre-fills this with a generated value; the backend then bakes it into
# config/cloudflare-worker-bouncer.yaml on start, so there is nothing else to wire up.
CROWDSEC_BOUNCER_KEY=change-me

# Shared secret between the CrowdSec agent and the Lua bouncer running inside
# Nginx Proxy Manager (§119) — the one that actually enforces bans, by 403ing
# banned IPs on every proxied request. Generated the same way, and baked into
# NPM's crowdsec-bouncer/crowdsec-nginx-bouncer.conf on start. A separate key
# from the one above so a bouncer can be revoked on its own (`cscli bouncers
# delete nginx`).
CROWDSEC_NGINX_BOUNCER_KEY=change-me

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
