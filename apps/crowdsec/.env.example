# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# CrowdSec has no web UI and publishes no host port — its local API is only
# reached by the bundled bouncer over the compose network.

# Shared secret between the CrowdSec agent and the Cloudflare bouncer. Any long
# random string (e.g. `openssl rand -hex 32`). The dashboard's Configuration
# panel pre-fills this with a generated value; the backend then bakes it into
# config/cloudflare-worker-bouncer.yaml on start, so there is nothing else to wire up.
CROWDSEC_BOUNCER_KEY=change-me

# Shared secret between the CrowdSec agent and the Lua bouncer running inside
# Nginx Proxy Manager (§119) — the one that actually enforces bans, by 403ing
# banned IPs on every proxied request. Generated the same way, and baked into
# NPM's crowdsec-bouncer/crowdsec-nginx-bouncer.conf on start. A separate key
# from the one above so a bouncer can be revoked on its own (`cscli bouncers
# delete nginx`).
CROWDSEC_NGINX_BOUNCER_KEY=change-me

# The dashboard's machine login on the local API, so Settings can list and
# lift bans (plan.md §540) — bouncer keys can only read. Generated on first
# start and registered with CrowdSec by the backend; never shown or typed.
CROWDSEC_DASHBOARD_PASSWORD=change-me

# Optional: enrolls this instance with CrowdSec Console (https://app.crowdsec.net)
# so alerts/decisions show up there and it can pull the community blocklist
# CrowdSec curates from every enrolled instance (plan.md §567.2). Create an
# account there (Google or email/password — that signup itself is on
# CrowdSec's own site, nothing this dashboard can do), add a "security
# engine", and paste the enroll key it gives you into the CrowdSec card's
# Configuration panel here in the dashboard — never edit this file by hand.
# The image's own entrypoint runs `cscli console enroll` with it on every
# start (the local API's machine identity isn't persisted across a container
# recreation, so this must be supplied every time, same as the bouncer keys
# above). Leave blank to skip Console entirely — CrowdSec fully works without
# it. After saving, accept the pending security engine at app.crowdsec.net.
CROWDSEC_CONSOLE_ENROLL_KEY=

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
