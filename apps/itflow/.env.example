# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Host port for the web UI. start.sh allocates this — see docs/ports.md.
ITFLOW_PORT=10420

# Shown in ITFlow's own UI and in the emails it sends.
ITFLOW_NAME=ITFlow

# Public URL ITFlow builds its links from (password resets, ticket replies,
# client portal). Managed automatically from the exposure settings once
# "Publicly expose this service" is on — the dashboard shows it read-only.
ITFLOW_URL=

# Internal MariaDB password. Generated by the dashboard and never displayed;
# nothing outside this app's compose project uses it.
ITFLOW_DB_PASSWORD=

# Admin password for the account the dashboard creates through ITFlow's
# first-run wizard (ITFlow has no SSO that fits here). Auto-generated on first
# start if left blank; set your own here first if you want to choose it.
ITFLOW_ADMIN_PASSWORD=

# Database name/user. Only change these before the first start — ITFlow's
# installer creates the schema against whatever they say, and changing them
# afterwards points it at a database that does not exist.
ITFLOW_DB_NAME=itflow
ITFLOW_DB_USER=itflow

# info | debug. Raise only while troubleshooting; debug is noisy.
ITFLOW_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Email + cron
#
# ITFlow does NOT read mail settings or a cron toggle from the environment —
# both live in its own database, normally set by hand in its own UI. The
# dashboard writes them for you instead, on every ITFlow start
# (backend/src/services/itflowMailCron.ts, §62.1): the dashboard's global
# mail settings (Settings -> Email) are copied into ITFlow's SMTP/IMAP config,
# and ITFlow's master cron switch (Maintenance -> Cron) is switched on so
# email-to-ticket, the mail queue and recurring invoices actually run.
# Nothing to set here.
# ---------------------------------------------------------------------------
