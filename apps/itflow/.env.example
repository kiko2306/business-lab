# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Host port for the web UI. start.sh allocates this — see docs/ports.md.
ITFLOW_PORT=10420

# Shown in ITFlow's own UI and in the emails it sends.
ITFLOW_NAME=ITFlow

# Public URL ITFlow builds its links from (password resets, ticket replies,
# client portal). Managed automatically from the exposure settings once
# "Publicly expose this service" is on — the dashboard shows it read-only.
ITFLOW_URL=

# Internal MariaDB password. Generated by the dashboard and never displayed;
# nothing outside this app's compose project uses it.
ITFLOW_DB_PASSWORD=

# Database name/user. Only change these before the first start — ITFlow's
# installer creates the schema against whatever they say, and changing them
# afterwards points it at a database that does not exist.
ITFLOW_DB_NAME=itflow
ITFLOW_DB_USER=itflow

# info | debug. Raise only while troubleshooting; debug is noisy.
ITFLOW_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Email
#
# ITFlow does NOT read mail settings from the environment — it stores them in
# its own database, configured in its UI under Settings. The dashboard's global
# mail settings (Settings -> Email) are the values to copy in; they cannot be
# injected automatically the way they are for other apps. See plan.md §62.1.
#
# Cron drives email-to-ticket, the mail queue and recurring invoices. The image
# already runs it — there is no cron container and nothing to schedule on the
# host — but it must be switched on inside ITFlow:
#   Settings -> Notifications -> enable Cron
# and the jobs themselves are managed under Maintenance -> Cron.
# ---------------------------------------------------------------------------
