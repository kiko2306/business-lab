# Tally — invoices, employees and payments control (plan.md §622, §628).
# Copy to .env; the dashboard generates and writes the secret itself.

# Host port. Allocated per docs/ports.md; start.sh moves it only if taken.
TALLY_PORT=10610

# Bundled Postgres. The password is generated by the dashboard on first start
# (hiddenGeneratedSecrets in services.ts) — never set it by hand.
TALLY_DB_NAME=tally
TALLY_DB_USER=tally
TALLY_DB_PASSWORD=
