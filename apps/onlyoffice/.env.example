# Copy this template alongside it, without the .example suffix, and set values
# before starting the app. Docker Compose loads it automatically from the app's
# project directory.

ONLYOFFICE_PORT=10460

# Shared secret between the document server and whatever embeds it. The
# dashboard generates this (see autoGeneratedSecrets in services.ts) — the same
# value has to be entered in Nextcloud's ONLYOFFICE connector settings, so read
# it from the app's config panel rather than inventing one here.
ONLYOFFICE_JWT_SECRET=

# Header the signed token travels in. Nextcloud's connector defaults to
# Authorization; change both together or neither.
ONLYOFFICE_JWT_HEADER=Authorization
