# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Host port for the web UI. start.sh allocates this — see docs/ports.md.
KIMAI_PORT=10500

# Internal MariaDB password. Generated by the dashboard and never displayed;
# nothing outside this app's compose project uses it. Kept hex so it survives
# the entrypoint's awk-based DATABASE_URL parsing.
KIMAI_DB_PASSWORD=

# Database name/user. Only change these before the first start — Kimai's
# installer builds the schema against whatever they say.
KIMAI_DB_NAME=kimai
KIMAI_DB_USER=kimai

# Super-admin password for the account the dashboard creates on first start
# (Kimai has no SSO that fits here). Auto-generated if left blank; set your own
# here first if you want to choose it. The email is injected automatically at
# start (the Authelia admin's).
KIMAI_ADMIN_PASSWORD=

# Symfony trusted hosts. This is a single regex, so entries are PIPE-separated
# (not comma). The dashboard appends the public hostname when exposure is on; a
# wrong value is a hard 400 on every request.
KIMAI_TRUSTED_HOSTS=localhost|127.0.0.1

# Trusted reverse-proxy networks (comma-separated). Filled with 0.0.0.0/0 by
# the dashboard when exposure is on (NPM is then the only ingress); leave blank
# for LAN-only.
KIMAI_TRUSTED_PROXIES=

# Optional SMTP, as a single DSN: smtp://user:pass@host:port
# Kimai does not read per-field mail settings, so the dashboard's global mail
# config cannot be injected — set this by hand if you want password-reset /
# notification emails. `null://null` disables mail.
KIMAI_MAILER_URL=null://null
