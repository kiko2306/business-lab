<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48 x86, not net8.0 like tally's agent, and not AnyCPU/x64 (plan.md
      §629, §636). Unlike tally, this agent's reads AND writes go through
      Wintouch's own in-process business-tier API (Unidades, Terceiros,
      Reservas, ReservasEntidades) rather than a SQL connection string —
      confirmed by reading the legacy WHotWebService source directly (its
      Unit/Guest/Reservation DAOs all call into Wintouch.Hotel.Businesstier,
      including the guest "exportado" watermark, which the legacy runs
      through Wintouch's own CommandDirectSQL rather than a plain
      SqlConnection). Those assemblies are .NET Framework 4.8, PE32 (x86)
      only, so the host process must match on both counts or fail to load
      them with a BadImageFormatException that does not point at bitness.
    -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>Hotel.Agent</RootNamespace>
    <AssemblyName>Hotel.Agent</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Windows service hosting: the same package the legacy uses, and one
         known to work on net48 (Microsoft.Extensions.Hosting.WindowsServices
         targets net6.0+ only, so tally's modern approach isn't available
         here). -->
    <PackageReference Include="Topshelf" Version="4.3.0" />
    <!-- DPAPI. net48 doesn't ship System.Security.Cryptography.ProtectedData
         in-box the way net8.0 does (tally's TokenStore needs no package). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Data.DataSetExtensions" />
    <!--
      Wintouch's own assemblies, referenced exactly the way the legacy
      project does — HintPath to the real install, Private=false so csc
      never copies proprietary vendor DLLs anywhere (this repo is public).
      Not restorable in CI: these files exist only on a machine with
      Wintouch installed, so there is no CI job for this project (unlike
      tally-agent's, which needs no vendor DLL). See README.md.
    -->
    <Reference Include="Wintouch.Core">
      <HintPath>C:\wintouch\sgw\Wintouch.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Wintouch.Core.Data">
      <HintPath>C:\wintouch\sgw\Wintouch.Core.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Wintouch.Hotel.Businesstier">
      <HintPath>C:\wintouch\sgw\Wintouch.Hotel.Businesstier.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Wintouch.Hotel.Datatier">
      <HintPath>C:\wintouch\sgw\Wintouch.Hotel.Datatier.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Wintouch.Manager.Businesstier">
      <HintPath>C:\wintouch\sgw\Wintouch.Manager.Businesstier.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Not called directly, but ReloadSettings()'s own return path touches
         a type here, so the compiler needs it resolvable too. -->
    <Reference Include="Wintouch.Manager.Datatier">
      <HintPath>C:\wintouch\sgw\Wintouch.Manager.Datatier.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="hotel.config.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
