# Hotel — online check-in, guest feedback and property administration
# (plan.md §620, §623, §628). Copy to .env; the dashboard generates the secret.

# Host ports. Allocated per docs/ports.md.
# The admin UI, which is the app's front door.
HOTEL_ADMIN_PORT=10600

# The guest-facing check-in app, public — a guest follows an emailed link
# with no account (plan.md §641).
HOTEL_CHECKIN_PORT=10601

# The guest-facing feedback app, public — same reasoning as check-in
# (plan.md §644).
HOTEL_PULSE_PORT=10602

# hotel-core, which the property agent reaches on its own hostname.
HOTEL_CORE_PORT=10603

# Bundled Postgres, shared by every service in this project. The password is
# generated by the dashboard on first start (hiddenGeneratedSecrets in
# services.ts) — never set it by hand.
HOTEL_DB_NAME=hotel
HOTEL_DB_USER=hotel
HOTEL_DB_PASSWORD=
