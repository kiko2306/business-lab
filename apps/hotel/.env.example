# Hotel — online check-in, guest feedback and property administration
# (plan.md §620, §623, §628). Copy to .env; the dashboard generates the secret.

# Host port for hotel-core. Allocated per docs/ports.md.
# check-in (10601), pulse (10602) and the admin shell (10600) join as they land.
HOTEL_CORE_PORT=10603

# Bundled Postgres, shared by every service in this project. The password is
# generated by the dashboard on first start (hiddenGeneratedSecrets in
# services.ts) — never set it by hand.
HOTEL_DB_NAME=hotel
HOTEL_DB_USER=hotel
HOTEL_DB_PASSWORD=
