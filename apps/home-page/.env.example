# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

HOMEPAGE_PORT=3000

# Comma-separated, no spaces. Required to reach the dashboard from anything
# other than localhost:3000 — add your LAN IP and/or hostname, e.g.
# HOMEPAGE_ALLOWED_HOSTS=localhost:3000,192.168.1.23:3000
HOMEPAGE_ALLOWED_HOSTS=localhost:3000
