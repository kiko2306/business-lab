# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

FILEBROWSER_PORT=10160
# Host directory to expose in File Browser, mounted under the server root at
# the same absolute path it has on the host. Reaches ~/.ssh and every
# apps/*/.env — narrow it to a subdirectory (e.g. /home/mat/www) if that is
# more access than you want the file manager to have.
FILEBROWSER_HOME=/home/mat
