# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

TZ=Europe/Lisbon

# How often Watchtower checks for new images, in seconds. Default: 86400
# (once a day). Every container on this host gets watched unless it carries
# the com.centurylinklabs.watchtower.enable=false label — see the top-level
# docker-compose.yml, where this dashboard's own frontend/backend/database
# containers opt out so an auto-update can't restart the dashboard managing
# your other apps out from under you.
WATCHTOWER_POLL_INTERVAL=86400
