# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

WAHA_PORT=10400
# Image tag. `latest` is amd64-only; on arm64 hosts (Raspberry Pi) set this to
# `arm`, which is the ARM64 build upstream publishes separately.
WAHA_IMAGE_TAG=latest

# WhatsApp engine: WEBJS (default, runs headless Chromium), NOWEB, or GOWS.
WAHA_ENGINE=WEBJS

# Left blank on purpose — the dashboard generates these on first start (read
# them back from this file or the Configuration panel). WAHA_API_KEY is sent by
# API clients as the `X-Api-Key` header; the two passwords are HTTP basic-auth
# for /dashboard and the Swagger UI.
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=

# Base URL WAHA puts in webhook payloads and Swagger. The dashboard rewrites
# this to the generated https:// hostname once exposure is enabled. Restart
# to apply.
WAHA_BASE_URL=http://localhost:3009

# Print the pairing QR code to the container logs on session start.
WAHA_PRINT_QR=false

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.
