# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NETBIRD_MGMT_PORT=10250
NETBIRD_DASHBOARD_PORT=10251
# Signal's gRPC port on the host. Published so the tailscale container can
# reach it via the docker gateway and publish it through Funnel — see
# NETBIRD_SIGNAL_HOSTNAME below.
NETBIRD_SIGNAL_PORT=10252
# Signal's PUBLIC hostname, as handed to every peer in data/management.json.
# This is NOT a <BASE_DOMAIN> hostname and is not served by Cloudflare.
#
# Signal registers a peer by replying with response HEADERS on a gRPC stream
# that then stays open. Cloudflare never flushes headers on an open stream, so
# signal simply cannot work behind the Cloudflare Tunnel — on any transport
# (measured both ways; see plan.md §52). Tailscale Funnel does flush them, so
# signal is published through the tailscale app instead, at that node's
# <node>.<tailnet>.ts.net name.
#
# start.sh derives this automatically from the running tailscale container and
# enables Funnel for it, so normally you never set it by hand. It is per-node,
# so it differs on every install.
NETBIRD_SIGNAL_HOSTNAME=

# Relay: WebSocket fallback data path for peers that can't hole-punch a direct
# tunnel (phone on mobile-data CGNAT → home peer with no port-forward). Not
# gRPC, so it traverses the Cloudflare Tunnel where signal's bidi stream can't.
# Its own public hostname (netbird-vpn-relay.<BASE_DOMAIN>) is auto-provisioned
# alongside the other two — see additionalExposures in
# backend/src/config/services.ts. Container listens on :33080.
NETBIRD_RELAY_PORT=10253
# Shared HMAC secret: must be identical to the Relay.Secret in
# data/management.json. start.sh generates it into .env and substitutes the
# same value into data/management.json when it generates that file.
NETBIRD_RELAY_AUTH_SECRET=

# The public domain this app's hostnames are derived from — the dashboard's
# management/gRPC endpoints and Authelia's authority in docker-compose.yml, and
# every URL in data/management.json. start.sh writes this from the domain it
# prompts for and generates data/management.json from
# config/management.json.example accordingly, so nothing here needs editing by
# hand for a new domain.
BASE_DOMAIN=
#
# Routing peer (apps/netbird-vpn/docker-compose.yml's netbird-client
# service): lets a remote NetBird peer reach this box's whole LAN, not just
# this box.
#
# Set NETBIRD_API_TOKEN below and the network resource, router, policy and
# this setup key are all created and kept in sync automatically (§405) —
# nothing to do here. Without a token, paste in a setup key generated by
# hand from the NetBird dashboard's Remote Network Access wizard ("Generate
# Setup Key" on the "Add a routing peer" step); once a token is set, the
# automation takes over this value and overwrites whatever's here.
NETBIRD_ROUTING_PEER_SETUP_KEY=change-me
# A NetBird Personal Access Token (dashboard → Settings → Personal Access
# Tokens, after logging in) — genuinely third-party, only NetBird's own UI
# can mint it. Lets the Business Lab backend drive NetBird's management API
# on your behalf (create the network/resource/router/policy/setup key above,
# and re-mint the setup key if it ever expires) instead of you clicking
# through that wizard on every fresh deployment. Optional: leave as
# change-me to do it by hand instead.
NETBIRD_API_TOKEN=change-me
#
# This app authenticates through Authelia (apps/authelia/) and is reachable at
# https://netbird-vpn.<BASE_DOMAIN>. The dashboard is a static SPA with no
# server-side proxy for /api, so its management API gets its own public
# hostname (netbird-vpn-api.<BASE_DOMAIN>), and the relay gets one too
# (netbird-vpn-relay.<BASE_DOMAIN>). Both are provisioned automatically when
# "Publicly expose this service" is enabled for NetBird VPN — see
# additionalExposures on this service in backend/src/config/services.ts.
# Signal is deliberately NOT among them; it goes over Tailscale Funnel
# instead (NETBIRD_SIGNAL_HOSTNAME above, plan.md §52/§53).
#
# If start.sh generated data/management.json for you, there is nothing further
# to do. To regenerate it by hand (it holds a real DataStoreEncryptionKey and
# is gitignored, so it is never committed):
#   BASE_DOMAIN=example.com python3 -c "
#   import base64, json, os, secrets
#   t = open('config/management.json.example').read()
#   d = json.loads(t.replace('\${BASE_DOMAIN}', os.environ['BASE_DOMAIN']))
#   d['DataStoreEncryptionKey'] = base64.b64encode(secrets.token_bytes(32)).decode()
#   json.dump(d, open('data/management.json', 'w'), indent=2)
#   "
# (the by-hand form above also needs ${NETBIRD_RELAY_AUTH_SECRET} substituted
# from this .env — start.sh's generator does both replacements.)
