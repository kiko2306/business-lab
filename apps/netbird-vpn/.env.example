# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NETBIRD_MGMT_PORT=8080
NETBIRD_DASHBOARD_PORT=8081
# Signal's gRPC port. Needs its own public hostname for remote peers — see
# the Signal block in config/management.json.example.
NETBIRD_SIGNAL_PORT=8086

# This app authenticates through Authelia (apps/authelia/) and expects to be
# reachable at https://netbird-vpn.tx-home-utils.com — see the OIDC client
# redirect_uris in apps/authelia/config/configuration.yml and the endpoint
# URLs in config/management.json.example. If your domain differs, update
# all three consistently before starting this app.
#
# The dashboard is a static SPA with no server-side proxy for /api, so its
# management API needs its own public hostname too — this is provisioned
# automatically (a second hostname, netbird-vpn-api.<base-domain>) whenever
# you enable "Publicly expose this service" for NetBird VPN in the
# dashboard's Exposure settings; see additionalExposures on this service in
# backend/src/config/services.ts if you need to point it somewhere custom.
#
# Before first start, generate the real working config (gitignored, holds a
# real DataStoreEncryptionKey — never committed) from the tracked template:
#   python3 -c "
#   import json, secrets, base64
#   d = json.load(open('config/management.json.example'))
#   d['DataStoreEncryptionKey'] = base64.b64encode(secrets.token_bytes(32)).decode()
#   json.dump(d, open('data/management.json', 'w'), indent=2)
#   "
