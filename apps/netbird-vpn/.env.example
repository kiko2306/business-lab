# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NETBIRD_MGMT_PORT=8080
NETBIRD_DASHBOARD_PORT=8081
# Signal's gRPC port. Needs its own public hostname for remote peers — see
# the Signal block in config/management.json.example.
NETBIRD_SIGNAL_PORT=8086
# Relay: WebSocket fallback data path for peers that can't hole-punch a direct
# tunnel (phone on mobile-data CGNAT → home peer with no port-forward). Not
# gRPC, so it traverses the Cloudflare Tunnel where signal's bidi stream can't.
# Its own public hostname (netbird-vpn-relay.<BASE_DOMAIN>) is auto-provisioned
# alongside the other two — see additionalExposures in
# backend/src/config/services.ts. Container listens on :33080.
NETBIRD_RELAY_PORT=8087
# Shared HMAC secret: must be identical to the Relay.Secret in
# data/management.json. start.sh generates it into .env and substitutes the
# same value into data/management.json when it generates that file.
NETBIRD_RELAY_AUTH_SECRET=

# The public domain this app's hostnames are derived from — the dashboard's
# management/gRPC endpoints and Authelia's authority in docker-compose.yml, and
# every URL in data/management.json. start.sh writes this from the domain it
# prompts for and generates data/management.json from
# config/management.json.example accordingly, so nothing here needs editing by
# hand for a new domain.
BASE_DOMAIN=
#
# This app authenticates through Authelia (apps/authelia/) and is reachable at
# https://netbird-vpn.<BASE_DOMAIN>. The dashboard is a static SPA with no
# server-side proxy for /api, so its management API gets its own public
# hostname (netbird-vpn-api.<BASE_DOMAIN>), and signal needs one too
# (netbird-vpn-signal.<BASE_DOMAIN>) because native clients connect to it
# directly. Both are provisioned automatically when "Publicly expose this
# service" is enabled for NetBird VPN — see additionalExposures on this
# service in backend/src/config/services.ts.
#
# If start.sh generated data/management.json for you, there is nothing further
# to do. To regenerate it by hand (it holds a real DataStoreEncryptionKey and
# is gitignored, so it is never committed):
#   BASE_DOMAIN=example.com python3 -c "
#   import base64, json, os, secrets
#   t = open('config/management.json.example').read()
#   d = json.loads(t.replace('\${BASE_DOMAIN}', os.environ['BASE_DOMAIN']))
#   d['DataStoreEncryptionKey'] = base64.b64encode(secrets.token_bytes(32)).decode()
#   json.dump(d, open('data/management.json', 'w'), indent=2)
#   "
# (the by-hand form above also needs ${NETBIRD_RELAY_AUTH_SECRET} substituted
# from this .env — start.sh's generator does both replacements.)
