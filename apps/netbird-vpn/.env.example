# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NETBIRD_MGMT_PORT=8080
NETBIRD_DASHBOARD_PORT=8081

# This app authenticates through Authelia (apps/authelia/) and expects to be
# reachable at https://netbird-vpn.tx-home-utils.com — see the OIDC client
# redirect_uris in apps/authelia/config/configuration.yml and the endpoint
# URLs in apps/netbird-vpn/config/management.json. If your domain differs,
# update all three consistently before starting this app.
