# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

# Host port for the browser terminal. Only ever reached through Nginx Proxy
# Manager (which adds the Authelia gate) — do NOT expose this port directly.
WETTY_PORT=3030

# Where wetty SSHes to. The default resolves to the docker gateway via the
# extra_hosts entry in docker-compose.yml, i.e. this same machine.
WETTY_SSH_HOST=host.docker.internal
WETTY_SSH_PORT=22

# The host account the browser terminal logs in as. start.sh sets this to the
# user who ran it (SUDO_USER) and installs the matching public key into that
# user's ~/.ssh/authorized_keys.
WETTY_SSH_USER=

# Shown in the browser tab.
WETTY_TITLE=homelab

# Used only for the homepage tile link.
BASE_DOMAIN=
