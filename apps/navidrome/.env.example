# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

NAVIDROME_PORT=10570

# Absolute host path to your music library, e.g. /home/mat/music. Leave unset
# to just use a folder inside this app's own data dir. Mounted read-only.
NAVIDROME_MUSIC_DIR=./data/music

# TZ is inherited from the dashboard-wide timezone (Settings). Set it here
# only to pin a different zone for this one app.

# There is no admin username/password here: Navidrome creates the first
# (admin) account through its web setup screen on first visit, like Jellyfin.

# Password for the admin account the dashboard creates on first start via
# Navidrome's own createAdmin endpoint. The username is the Authelia admin's
# username (Navidrome logins are username-based). Auto-generated on first
# start if left blank; set your own here first if you want to choose it.
NAVIDROME_ADMIN_PASSWORD=
