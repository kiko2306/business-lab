# Copy to .env in this directory and set secure values before starting the app.
# Docker Compose loads this file automatically from the app's project directory.

TWENTY_PORT=10580

# Optional image-tag override (defaults to the pinned version in the compose
# file). Twenty runs DB migrations on boot with no downgrade — only change
# this via the dashboard's self-update, which bumps it deliberately.
#TWENTY_TAG=

# The database password and the app secret are left blank — the dashboard
# generates both on first start. The DB password is internal; the app secret
# is shown in the Configuration panel (back it up — losing it makes
# field-encrypted values unreadable).
TWENTY_DB_NAME=twenty
TWENTY_DB_USER=twenty
TWENTY_DB_PASSWORD=

TWENTY_APP_SECRET=

# First visitor to the site creates the workspace owner account. Set this to
# false (here, or live in Settings → Admin Panel → Configuration Variables)
# once that account exists so nobody else can self-register.
TWENTY_SIGN_UP_ENABLED=true

# SERVER_URL is not set here: when exposure is enabled for this service in the
# dashboard, the backend injects it at start time from the configured public
# hostname. It falls back to http://localhost:10580 otherwise. Restart the
# service after toggling exposure so the new value applies.
