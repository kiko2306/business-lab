        <mxCell id="e1" value="2. Insert run row — state=checking" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1" source="a1s" target="a1d"><mxGeometry relative="1" as="geometry"/></mxCell>
