        <mxCell id="e9" value="9. New backend process boots → finds state=restarting_backend&lt;br&gt;→ reconcileDanglingSelfUpdateRun() → state=done + audit log" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1" source="a9s" target="a9d"><mxGeometry relative="1" as="geometry"/></mxCell>
