        <mxCell id="e6" value="7. state=restarting_backend, finished=true&lt;br&gt;+ write audit log" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1" source="a6s" target="a6d"><mxGeometry relative="1" as="geometry"/></mxCell>
