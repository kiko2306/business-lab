        <mxCell id="e5" value="6. compose up -d --build frontend&lt;br&gt;— state=restarting_frontend" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1" source="a5s" target="a5d"><mxGeometry relative="1" as="geometry"/></mxCell>
