        <mxCell id="e7" value="8. spawn DETACHED: compose up -d --build backend&lt;br&gt;(self-replacing — fired and unref&#x27;d, not awaited)" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1" source="a7s" target="a7d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note8" value="This backend process is replaced by step 8. Nothing after it can rely on still running — that&#x27;s why run state lives in Postgres, not memory." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="565" width="1230" height="42" as="geometry"/></mxCell>
