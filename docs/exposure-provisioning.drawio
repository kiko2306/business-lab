        <mxCell id="e9" value="10. Return result — never blocks the start,&lt;br&gt;even if this failed" style="html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1" source="a9s" target="a9d"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note10" value="Teardown order is reversed: Cloudflare first, then NPM. A mid-failure then leaves a harmless orphaned NPM host, never a live DNS record pointing at nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=2;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="631" width="1230" height="38" as="geometry"/></mxCell>
