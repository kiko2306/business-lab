# Environment secrets — never commit these (but keep .env.example templates)
.env
.env.*
!.env.example

# Per-app persistent data (bind-mounted from each app's own folder)
apps/*/data/
# ...except Home Page's, which is mostly checked-in dashboard config
# (settings.yaml, widgets.yaml, custom.css, etc.), not runtime state.
!apps/home-page/data/
!apps/home-page/data/**
# ...but these three ARE runtime state now: homepageConfig.ts regenerates them
# from each app's exposure state on every start/stop/exposure change (§114).
apps/home-page/data/services.yaml
apps/home-page/data/docker.yaml
apps/home-page/data/bookmarks.yaml

# Authelia's real user database — holds a password hash for the SSO account
# that guards every exposed app. Keep the .example template only.
apps/authelia/config/users_database.yml

# CrowdSec's Cloudflare-bouncer config holds an API token + the LAPI key
# (keep the .example template).
apps/crowdsec/config/*-bouncer.yaml
# profiles.yaml + the notification-http config are rendered by the backend on
# each CrowdSec start (§118.1) — runtime state, not checked in. Keep the
# .example templates.
apps/crowdsec/config/profiles.yaml
apps/crowdsec/config/notifications/http.yaml

# n8n workflows are rendered by the backend on each n8n start
# (services/n8nWorkflows.ts) — runtime state. Keep the directory (.gitkeep).
apps/n8n/workflows/*.json

# Node modules
node_modules/
*/node_modules/

# Build artifacts
dist/
*/dist/
.angular/
*/.angular/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Claude Code — the project rules, settings and hooks are shared; personal
# overrides and scheduler state are not.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Written by the backend on every start of the Kitchen switcher from live
# exposure state and allocated ports (services/kitchenConfig.ts).
apps/kitchen-switcher/html/config.json
