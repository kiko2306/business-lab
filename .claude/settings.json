{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./apps/*/.env)",
      "Edit(./.env)",
      "Edit(./apps/*/.env)",
      "Write(./.env)",
      "Write(./apps/*/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guards.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a management-stack teardown"
          }
        ]
      }
    ]
  }
}
